# Copy to /etc/beacon/deploy.env, owned by root with mode 600.

# Folder holding compose.yaml and .env.
BEACON_DIR=/home/ubuntu/beacon

# User that owns the clone; git runs as this user.
BEACON_USER=ubuntu

# Checked after each deploy; it must return 200.
HEALTH_URL=https://beaconchat.org/api/health

# systemd service started before each deploy. Leave empty to deploy without a backup.
BACKUP_SERVICE=beacon-backup.service
